# Copy to .env.local (gitignored). Both are safe to expose to the browser —
# the anon/publishable key only grants what RLS allows.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Material (files on Cloudflare R2, served through /api) ──
# Server-only — set in Vercel (Production + Preview) and here for `vercel dev`.
# NEVER prefix these with VITE_: they would ship in the browser bundle.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=angus-documents
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Local dev has no /api; point the client at the deployed functions.
VITE_API_BASE=https://angus-xi.vercel.app
